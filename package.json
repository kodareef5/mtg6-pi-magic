{
  "name": "pi-magic",
  "version": "0.0.1",
  "description": "Run a Magic table in Pi with projected seat views, recorded decisions and prepared ability experiments.",
  "keywords": [
    "pi-package",
    "pi",
    "magic",
    "mtg",
    "multi-agent"
  ],
  "license": "MIT",
  "type": "module",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "src",
    "assets",
    "skills",
    "cards",
    "decks",
    "prepared/packages",
    "rules",
    "tools",
    "docs",
    "README.md"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node tools/test.ts fast",
    "test:slow": "node tools/test.ts slow",
    "test:all": "node tools/test.ts all",
    "cards": "node tools/cards.ts --format standard --columns lean -o cards/standard.tsv --verify",
    "universe": "node tools/cards.ts --verify",
    "rules": "node tools/rules.ts --verify -o rules/cr.tsv",
    "smoke": "node tools/smoke.ts",
    "matchup": "node tools/matchup.ts",
    "stats": "node tools/stats.ts",
    "pregame": "node tools/pregame.ts",
    "benchmark": "node tools/benchmark.ts",
    "timeline": "node tools/timeline.ts",
    "sim": "node tools/sim.ts",
    "decks": "node tools/decks.ts",
    "guide": "node tools/guide.ts",
    "art": "node tools/card-art.ts"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "typebox": "^1.3.27"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.1.0",
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22"
  },
  "optionalDependencies": {
    "cardboard-api": "github:kodareef5/cardboard-api"
  }
}
